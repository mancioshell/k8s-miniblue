# Local secrets / overrides for the runbook scripts. Copy to `.env` (gitignored) and fill in.
# Loaded automatically by scripts/startup.sh.

# GitOps repo ArgoCD watches as the source of truth. Must match the repoURL in
# gitops/local/argocd-apps/*.yaml (use the .git form). Read by scripts/startup.sh to wire GitOps.
GITOPS_REPO_URL=https://github.com/<you>/<gitops-repo>.git

# Read-only GitHub PAT for a PRIVATE GitOps repo (ArgoCD repository auth). Leave unset for a public repo.
GITOPS_REPO_TOKEN=

# Optional: username paired with the PAT (defaults to "git").
# GITOPS_REPO_USERNAME=git

# --- GHCR (ghcr.io) — image + shared-chart registry (PRIVATE packages) ---
# Classic GitHub PAT with read:packages to PULL (k3s imagePullSecret + ArgoCD OCI repo,
# wired by scripts/startup.sh). Publishing is done by the build-publish.yml / publish-chart.yml
# GitHub Actions using the built-in GITHUB_TOKEN — no write:packages PAT needed here. Never commit it.
GHCR_TOKEN=
# Optional: GHCR owner/namespace and login user (default to "mancioshell").
# GHCR_OWNER=mancioshell
# GHCR_USERNAME=mancioshell

# --- miniblue source pin (fork build) ---
# The local `miniblue:full` image is built from this fork/ref (see scripts/lib/common.sh).
# Override only to test a different branch or your own fork.
# MINIBLUE_SRC_REPO=https://github.com/mancioshell/miniblue.git
# MINIBLUE_SRC_REF=wi-keyvault
# Force a fresh rebuild + container restart from the pinned ref (use after bumping the ref):
# MINIBLUE_FORCE_BUILD=1

# --- Workload Identity ---
# Optional: OIDC issuer stamped onto projected ServiceAccount tokens (k3s service-account-issuer)
# AND registered as the federated-credential issuer. Both sides read this same value; override only
# if you need a specific issuer. Defaults to https://miniblue.local/oidc (see scripts/lib/common.sh).
# MINIBLUE_SA_ISSUER=https://miniblue.local/oidc
